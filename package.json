{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "containment-breach",
    "version": "0.0.0",
    "private": true,
    "description": "Crash tests for AI apps.",
    "license": "UNLICENSED",
    "type": "module",
    "scripts": {
        "check": "vp check",
        "check:fix": "vp check --fix",
        "types:check": "tsc --noEmit",
        "test": "vp test run",
        "cb": "node packages/cli/bin.ts",
        "dashboard:data": "node apps/dashboard/scripts/build-data.ts",
        "dashboard:build": "npm run dashboard:data && vp build apps/dashboard",
        "dashboard:publish": "node apps/dashboard/scripts/build-data.ts --demo && vp build apps/dashboard",
        "dashboard:sample": "node apps/dashboard/scripts/build-data.ts --sample && vp build apps/dashboard"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "1.8.0",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@fontsource/figtree": "5.3.0",
        "@fontsource/jetbrains-mono": "5.3.0",
        "@types/node": "^24.0.0",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "typescript": "^5.7.2",
        "vite-plus": "1.8.0"
    },
    "engines": {
        "node": ">=24"
    }
}
